# Vercel server-only (không tạo biến VITE_ hoặc NEXT_PUBLIC_)
INFERENCE_BASE_URL=https://your-inference-host.example
INFERENCE_API_TOKEN=replace-with-a-long-random-secret
# Tùy chọn khóa website production. Nếu bỏ trống sẽ kiểm tra origin với Host.
PUBLIC_ORIGIN=https://aigiaotiep.vercel.app

# FastAPI inference host (dùng cùng chuỗi bí mật với Vercel)
MODEL_API_TOKEN=replace-with-a-long-random-secret
BASE_MODEL_ID=Qwen/Qwen3-0.6B
MODEL_VERSION=qwen3-0.6b-base
MODEL_ADAPTER_PATH=
MAX_CONTEXT_TOKENS=2048
MODEL_LOAD_ON_STARTUP=1
